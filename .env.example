# Panoptes Optional Cloud / Self-Hosted Environment Template
# Copy to .env if using optional Supabase sync. Never commit real keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
POSTGRES_DB=panoptes
POSTGRES_USER=panoptes_admin
POSTGRES_PASSWORD=replace_with_strong_random_secret
